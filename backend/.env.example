# Port & Node Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/linguachat
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=linguachat_super_secret_jwt_key_2026
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=linguachat_refresh_secret_key_2026
REFRESH_TOKEN_EXPIRY=30d

# Google Cloud Services
GOOGLE_APPLICATION_CREDENTIALS=./config/google-key.json
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_SPEECH_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# HuggingFace & Sentiment Analysis
HUGGINGFACE_API_KEY=

# Coturn / TURN / STUN Servers
TURN_SERVER_URL=turn:turn.linguachat.ai:3478
TURN_USERNAME=linguachat_user
TURN_CREDENTIAL=linguachat_secret_pass
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Mediasoup WebRTC Configuration
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
